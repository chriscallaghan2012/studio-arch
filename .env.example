# PAYPAL_CLIENT_ID: PayPal REST app client id (server-side, /api/paypal/*).
# PAYPAL_CLIENT_SECRET: PayPal REST app secret (server-side, /api/paypal/*).
# PAYPAL_ENV: "sandbox" for testing, "live" for real payments.
# VITE_PAYPAL_CLIENT_ID: same client id, exposed to the browser for the JS SDK.
# Get credentials from https://developer.paypal.com -> Apps & Credentials.
PAYPAL_CLIENT_ID="MY_PAYPAL_CLIENT_ID"
PAYPAL_CLIENT_SECRET="MY_PAYPAL_CLIENT_SECRET"
PAYPAL_ENV="sandbox"
VITE_PAYPAL_CLIENT_ID="MY_PAYPAL_CLIENT_ID"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
